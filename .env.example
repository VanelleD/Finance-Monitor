# Local development only. Copy to .env and fill in.
# Cloudflare deployments read SESSION_SECRET from `wrangler secret put` instead.

# Signs your login session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me-to-something-long-and-random

# Where the local SQLite file lives.
DATABASE_FILE=./data/finance.sqlite

# API port for local development.
PORT=8787
